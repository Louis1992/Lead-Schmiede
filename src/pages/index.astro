---
import Layout from '../layouts/Layout.astro';
import HeaderLeadGenies from '../components/leadgenies/HeaderLeadGenies.tsx';
import HeroSection from '../components/leadgenies/HeroSection.tsx';
import DataTransformSection from '../components/leadgenies/DataTransformSection.tsx';
import WhatWeDoSection from '../components/leadgenies/WhatWeDoSection.tsx';
import BenefitsSection from '../components/leadgenies/BenefitsSection.tsx';
import PricingSection from '../components/leadgenies/PricingSection.tsx';
import FAQSection from '../components/leadgenies/FAQSection.tsx';
import ContactSection from '../components/leadgenies/ContactSection.tsx';
import FooterSection from '../components/leadgenies/FooterSection.tsx';
import ROICalculator from '../components/leadgenies/ROICalculator.tsx';
import TestimonialSection from '../components/leadgenies/TestimonialSection.tsx';
import CrossSellBanner from '../components/leadgenies/CrossSellBanner.tsx';

// Language for this page
const lang = 'de';

// Page metadata (German)
const pageTitle = "Lead-Schmiede - Maßgeschneiderte B2B Lead-Listen";
const pageDescription = "Verifizierte B2B-Kontakte mit persönlicher ICP-Beratung. DSGVO-konform, manuell kuratiert. Ab €249 für 100 qualifizierte Leads.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="LocalBusiness"
  lang={lang}
>
  <HeaderLeadGenies lang={lang} client:load />

  <main class="relative" style="margin: 0; padding: 0; overflow-x: hidden; width: 100%;">
    <!-- Hero Section (contains the main H1) -->
    <HeroSection lang={lang} client:load />

    <!-- Data Transformation Section -->
    <DataTransformSection lang={lang} client:idle />

    <!-- ROI Calculator Section -->
    <ROICalculator lang={lang} client:idle />

    <!-- What We Do Section (Process + Comparison) -->
    <WhatWeDoSection lang={lang} client:idle />

    <!-- Benefits Section -->
    <section id="how-it-works">
      <BenefitsSection lang={lang} client:idle />
    </section>

    <!-- Pricing Section -->
    <PricingSection lang={lang} client:idle />

    <!-- Cross-Sell Banner (LeadGenies) - directly after pricing for upsell -->
    <CrossSellBanner lang={lang} client:idle />

    <!-- Testimonial Section -->
    <TestimonialSection lang={lang} client:idle />

    <!-- FAQ Section -->
    <section id="faq">
      <FAQSection lang={lang} client:idle />
    </section>

    <!-- Contact Section -->
    <ContactSection lang={lang} client:idle />

  </main>

  <!-- Footer Section -->
  <FooterSection lang={lang} client:load />
</Layout>

<style>
  /* Hide SEO elements visually but keep them for crawlers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
