---
import Layout from '../../layouts/Layout.astro';
import HeaderLeadGenies from '../../components/leadgenies/HeaderLeadGenies.tsx';
import HeroSection from '../../components/leadgenies/HeroSection.tsx';
import WhatWeDoSection from '../../components/leadgenies/WhatWeDoSection.tsx';
import ProblemSection from '../../components/leadgenies/ProblemSection.tsx';
import BenefitsSection from '../../components/leadgenies/BenefitsSection.tsx';
import PricingSection from '../../components/leadgenies/PricingSection.tsx';
import FAQSection from '../../components/leadgenies/FAQSection.tsx';
import ContactSection from '../../components/leadgenies/ContactSection.tsx';
import FooterSection from '../../components/leadgenies/FooterSection.tsx';

// Language for this page
const lang = 'en';

// Page metadata (English)
const pageTitle = "Lead-Schmiede - Custom B2B Lead Lists";
const pageDescription = "Verified B2B contacts with personal ICP consulting. GDPR-compliant, manually curated. From €149 for 100 qualified leads.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="LocalBusiness"
  lang={lang}
>
  <HeaderLeadGenies lang={lang} client:load />

  <main class="relative" style="margin: 0; padding: 0; overflow-x: hidden; width: 100%;">
    <!-- SEO H1 (hidden but crawlable) -->
    <h1 class="sr-only">Lead-Schmiede - Custom B2B Lead Lists with ICP Consulting</h1>

    <!-- Hero Section -->
    <HeroSection lang={lang} client:load />

    <!-- What We Do Section -->
    <WhatWeDoSection lang={lang} client:idle />

    <!-- Problem Agitation Section -->
    <ProblemSection lang={lang} client:idle />

    <!-- Benefits Section -->
    <section id="how-it-works">
      <BenefitsSection lang={lang} client:idle />
    </section>

    <!-- Pricing Section -->
    <PricingSection lang={lang} client:idle />

    <!-- FAQ Section -->
    <section id="faq">
      <FAQSection lang={lang} client:idle />
    </section>

    <!-- Contact Section -->
    <ContactSection lang={lang} client:idle />

  </main>

  <!-- Footer Section -->
  <FooterSection lang={lang} client:load />
</Layout>

<style>
  /* Hide SEO elements visually but keep them for crawlers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
